PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:8080,https://labels.brajmart.com
PUBLIC_APP_URL=http://localhost:8080
PUBLIC_API_URL=http://localhost:5000
PRINT_HANDOFF_TTL_SECONDS=90
MONGODB_URI=mongodb://127.0.0.1:27017/brajmart_shipping_labels
APP_AUTH_SECRET=change-this-to-a-long-random-string
APP_USERNAME=brajmaster
APP_PASSWORD_HASH=f6412bd354418eb6e2bc75d56ba896d9b9f6d0047d6a0ee0d9782f6ec5528d65

# TrackCourier.io Multi-Account Cascade Configuration
# Primary TrackCourier Key (Account 1 - quota currently exhausted, circuit breaker active)
TRACKCOURIER_API_KEY=
# Secondary TrackCourier Key (Account 2 - failover key when Account 1 is exhausted/unavailable)
TRACKCOURIER_BACKUP_API_KEY=
# Tertiary TrackCourier Key (Account 3 - failover key when Accounts 1 & 2 are exhausted/unavailable)
TRACKCOURIER_TERTIARY_API_KEY=

DELHIVERY_API_TOKEN=
DTDC_API_TOKEN=
# Public tracking cron webhook secret (used by external schedulers for POST /api/public/hooks/refresh-tracking)
PUBLIC_TRACKING_HOOK_SECRET=

# Shadowfax Direct Tracking API
# Method 1 (Standard): Static Token Authentication from SFX 360 Partner Portal (Get Testing Token / Get Production Token)
SHADOWFAX_API_TOKEN=
# Staging: https://dale.staging.shadowfax.in/api | Production: https://dale.shadowfax.in/api
SHADOWFAX_BASE_URL=https://dale.staging.shadowfax.in/api

# Method 2 (Optional): OAuth2 Client Credentials flow (exchanged at /v1/clients/token/)
SHADOWFAX_CLIENT_ID=
SHADOWFAX_CLIENT_SECRET=
SHADOWFAX_BEARER_TOKEN=

# Shadowfax Webhook Push Secret (used to verify inbound push notifications at POST /api/webhooks/shadowfax)
SHADOWFAX_WEBHOOK_SECRET=
